---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedIn } from '../../lib/content-model.ts';
import { sortByCreatedAt } from '../../lib/timeline.ts';
import { getColumn, getColumnEntries, startGroups } from '../../lib/taxonomy.ts';
import { columnUrl, consultingUrl } from '../../lib/content-paths.ts';
import { consultingAudience, consultingColumns, consultingOffer, i18n, professionalBackground } from '../../i18n/index.mjs';
import { site } from '../../data/site.mjs';

const locale = Astro.currentLocale ?? 'zh-CN';
const copy = i18n(locale).page.consulting;
const entries = sortByCreatedAt(await getCollection('consulting', publishedIn(locale)));
const offer = consultingOffer(locale);
const columnCopy = consultingColumns(locale);
const background = professionalBackground(locale);
const audience = consultingAudience(locale);
// Curated pillars shown as "coming soon" placeholders before their first entry
// exists. Any column actually used by a published entry is included too, so a
// newly introduced consulting column still surfaces here even if no one
// remembers to add it to this list. Order follows the editorial reading order
// declared in taxonomy's startGroups.
const CURATED_CONSULTING_COLUMNS = ['early-career-start', 'interview-job-search', 'career-management-growth', 'engineering-team-judgment'];
const columnsInUse = new Set(entries.map((e) => e.data.column?.slug).filter((slug) => slug !== undefined));
const columnSlugSet = new Set([...CURATED_CONSULTING_COLUMNS, ...columnsInUse]);
const columnSlugs = startGroups.flatMap((group) => group.columns).filter((slug) => columnSlugSet.has(slug));
const columnEntries = columnSlugs.map((slug) => ({
  slug,
  column: getColumn(slug, locale),
  allEntries: getColumnEntries(entries, slug),
}));
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription}>
  <section class="page-heading shell about consulting-heading">
    <p class="eyebrow">{copy.label}</p><h1>{copy.title[0]}<br />{copy.title[1]}</h1><p>{copy.description}</p><p class="about-intro">{copy.intro}</p>
  </section>
  <section class="shell section about-cooperate" aria-labelledby="consulting-audience-heading">
    <p class="eyebrow">{audience.eyebrow}</p><h2 id="consulting-audience-heading">{audience.title}</h2>
    <p class="about-cooperate-desc">{audience.description}</p>
    <ul class="about-cooperate-list">{audience.items.map((item) => <li><span>{item}</span></li>)}</ul>
  </section>
  <section class="shell section about-cooperate" aria-labelledby="consulting-services-heading">
    <p class="eyebrow">{copy.servicesEyebrow}</p><h2 id="consulting-services-heading">{copy.servicesTitle}</h2>
    <ul class="about-cooperate-list">{copy.services.map((service) => <li><strong>{service.title}</strong><span>{service.description}</span></li>)}</ul>
  </section>
  <section class="shell section about-cooperate" aria-labelledby="consulting-offer-heading">
    <p class="eyebrow">{offer.eyebrow}</p><h2 id="consulting-offer-heading">{offer.title}</h2><p class="about-cooperate-desc">{offer.description}</p>
    <ul class="about-cooperate-list">{offer.items.map((item) => <li><strong>{item.title}</strong><span>{item.description}</span></li>)}</ul>
    <p class="about-cooperate-desc">{offer.note}</p>
  </section>
  <section class="shell section about-background" aria-labelledby="consulting-background-heading">
    <p class="eyebrow">{background.consultingEyebrow}</p><h2 id="consulting-background-heading">{background.consultingTitle}</h2>
    <p class="about-cooperate-desc">{background.consultingDescription}</p>
    <p class="about-cooperate-desc">{background.consultingTeaching}</p>
    <p class="about-background-metrics">{background.consultingMetrics}</p>
  </section>
  <section class="shell section about-cooperate" aria-labelledby="consulting-format-heading">
    <p class="eyebrow">{copy.formatEyebrow}</p><h2 id="consulting-format-heading">{copy.formatTitle}</h2><p class="about-cooperate-desc">{copy.formatDescription}</p>
  </section>
  <section class="shell section about-cooperate" aria-labelledby="consulting-pricing-heading">
    <p class="eyebrow">{copy.pricingEyebrow}</p><h2 id="consulting-pricing-heading">{copy.pricingTitle}</h2><p class="about-cooperate-desc">{copy.pricingDescription}</p>
  </section>
  <section class="shell section consulting-columns" aria-labelledby="consulting-columns-heading">
    <p class="eyebrow">{columnCopy.eyebrow}</p><h2 id="consulting-columns-heading">{locale === 'en' ? 'Read the conversations by theme.' : '按主题，读这些咨询对话。'}</h2>
    <div class="consulting-column-grid">
      {columnEntries.map(({ slug, column, allEntries }) => <article class="consulting-column-card">
        <h3><a href={columnUrl(slug, locale)}>{column?.label ?? slug}</a><span>{columnCopy.count(allEntries.length)}</span></h3>
        <p>{column?.description}</p>
        {allEntries.length > 0 ? <ol>
          {allEntries.slice(0, 3).map((entry) => <li><a href={consultingUrl(entry.id, locale)}>{entry.data.title}</a></li>)}
        </ol> : <p class="consulting-column-empty">{columnCopy.empty}</p>}
        <a class="text-link" href={columnUrl(slug, locale)}>{columnCopy.readMore} <span aria-hidden="true">→</span></a>
      </article>)}
    </div>
  </section>
  <section class="shell section about-contact" aria-labelledby="consulting-contact-heading">
    <p class="eyebrow">{copy.contactEyebrow}</p><h2 id="consulting-contact-heading">{copy.contactTitle}</h2><p class="about-cooperate-desc">{copy.contactDescription}</p><a class="text-link" href={`mailto:${site.email}`}>{copy.contactAction}: {site.email} <span aria-hidden="true">↗</span></a>{locale !== 'en' && <p class="about-cooperate-desc">微信：{site.wechat}</p>}
    <p class="about-cooperate-desc">{copy.availabilityNote}</p>
    <p class="about-cooperate-desc">{copy.locationNote}</p>
  </section>
</BaseLayout>
