---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTag, getIndexableTags } from '../../lib/taxonomy.ts';
import { getAllPublished } from '../../lib/content-query.ts';
import { tagUrl } from '../../lib/content-paths.ts';
import { i18n } from '../../i18n/index.mjs';

const locale = Astro.currentLocale ?? 'zh-CN';
const copy = i18n(locale).page.tags;
const ui = i18n(locale);
const { writing, consulting, research, projects, galleries } = await getAllPublished(locale);
const tags = getIndexableTags([...writing, ...consulting, ...research, ...projects, ...galleries]);
---

<BaseLayout title={`${copy.eyebrow} — ${ui.brand}`} description={copy.description} pageKind="collection" section="tags" seoPage="tags">
  <section class="page-heading shell"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title[0]}<br />{copy.title[1]}</h1><p>{copy.description}</p></section>
  <section class="shell taxonomy-section archive-list"><ul class="topic-directory">{tags.map(({ slug, count }) => <li><a href={tagUrl(slug, locale)}>#{getTag(slug, locale).label}</a><span>{copy.count(count)}</span></li>)}</ul></section>
</BaseLayout>
