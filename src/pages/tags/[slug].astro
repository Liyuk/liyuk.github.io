---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import ContentEntryCard from '../../components/ContentEntryCard.astro';
import { getTag, getIndexableTags } from '../../lib/taxonomy.ts';
import { getAllPublished } from '../../lib/content-query.ts';
import { sortByCreatedAt } from '../../lib/timeline.ts';
import { resolveHub } from '../../lib/topic-hubs.ts';
import { i18n } from '../../i18n/index.mjs';

export async function getStaticPaths() {
  const { writing, consulting, research, projects, galleries } = await getAllPublished('zh-CN');
  return getIndexableTags([...writing, ...consulting, ...research, ...projects, ...galleries]).map(({ slug }) => ({ params: { slug }, props: {} }));
}

const { slug } = Astro.params;
const locale = Astro.currentLocale ?? 'zh-CN';
const ui = i18n(locale);
const pageCopy = i18n(locale).page;
const { writing, consulting, research, projects, galleries } = await getAllPublished(locale);
const indexableTags = getIndexableTags([...writing, ...consulting, ...research, ...projects, ...galleries]).map(({ slug: tagSlug }) => tagSlug);
const tag = getTag(slug, locale);
const entries = sortByCreatedAt([...writing, ...consulting, ...research, ...projects, ...galleries]).filter((entry) => entry.data.tags?.includes(slug));
const description = pageCopy.tags.detailDescription(tag.label);
const cards = pageCopy.tagCards;
const hub = resolveHub(slug, locale === 'en' ? 'en' : 'zh-CN', [...writing, ...consulting, ...research, ...projects]);
const hubCopy = pageCopy.tags.hub;
---

<BaseLayout title={hub ? `${hub.title} — ${ui.name}` : pageCopy.tags.detailTitle(tag.label, ui.name)} description={hub ? hub.description : description} keywords={hub?.searchTerms ?? [tag.label]} pageKind={hub ? 'collection' : 'website'} section={hub ? 'tags' : undefined} itemList={hub?.groups.flatMap((group) => group.items.map((item) => ({ name: item.title, url: item.url })))}>
  <section class="page-heading shell"><h1>{hub ? hub.title : `#${tag.label}`}</h1><p>{hub ? hub.intro : description}</p></section>
  {hub && (
    <section class="shell topic-hub" aria-labelledby="hub-reading-path">
      <h2 id="hub-reading-path">{hubCopy.readingPath}</h2>
      {hub.groups.map((group) => (
        <div class="topic-hub-group">
          <h3>{group.heading}</h3>
          <ul class="thread-list">{group.items.map((item) => <li><a href={item.url}>{item.title}</a><p>{item.why}</p></li>)}</ul>
        </div>
      ))}
      {hub.faqs.length > 0 && (
        <div class="topic-hub-group">
          <h2 id="hub-faq">{hubCopy.faq}</h2>
          <dl>{hub.faqs.map((faq) => <><dt>{faq.q}</dt><dd>{faq.a} <a href={faq.url}>{hubCopy.readMore}</a></dd></>)}</dl>
        </div>
      )}
      <h2 id="hub-all">{hubCopy.all(tag.label)}</h2>
    </section>
  )}
  <section class="shell entry-list archive-list thread-list">{entries.map((entry) => entry.collection === 'writing' ? <EntryCard entry={entry} indexableTags={indexableTags} locale={locale} /> : entry.collection === 'consulting' ? <EntryCard entry={entry} indexableTags={indexableTags} locale={locale} urlPrefix="consulting" /> : entry.collection === 'research' ? <ContentEntryCard entry={entry} collection="research" label={cards.research.label} action={cards.research.action} locale={locale} /> : entry.collection === 'project' ? <ContentEntryCard entry={entry} collection="project" label={cards.project.label} action={cards.project.action} locale={locale} /> : <ContentEntryCard entry={entry} collection="gallery" label={cards.gallery.label} action={cards.gallery.action} locale={locale} />)}</section>
</BaseLayout>
