---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import ShareRow from '../../components/ShareRow.astro';
import RssSubscribe from '../../components/RssSubscribe.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Comments from '../../components/Comments.astro';
import TipCard from '../../components/TipCard.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';
import { contentSlug, projectUrl } from '../../lib/content-paths.ts';
import { getIndexableTags, getRelatedEntries, RELATED_LIMIT } from '../../lib/taxonomy.ts';
import { getAllPublished, groupByLocaleVariant, pickLocaleVariant } from '../../lib/content-query.ts';
import { previewable } from '../../lib/content-model.ts';
import { formatFullDate, isoDate } from '../../lib/format-dates.ts';
import { i18n } from '../../i18n/index.mjs';
import { publishedDate, getChronologicalNeighbors } from '../../lib/timeline.ts';

export async function getStaticPaths() {
  const projects = await getCollection('project', previewable);
  return groupByLocaleVariant(projects, (entry) => contentSlug(entry.id)).map(({ slug, variants }) => ({
    params: { slug },
    props: { variants },
  }));
}

const { variants } = Astro.props;
const locale = Astro.currentLocale ?? 'zh-CN';
const entry = pickLocaleVariant(variants, locale)!;
const ui = i18n(locale);
const pageCopy = i18n(locale).page;
const { Content, headings } = await render(entry);
const { writing, research, projects, galleries } = await getAllPublished(locale);
const indexableTags = getIndexableTags([...writing, ...research, ...projects, ...galleries]).map(({ slug }) => slug);
const relatedEntries = getRelatedEntries([...writing, ...research, ...projects, ...galleries], entry, RELATED_LIMIT, locale);
const { previous: previousProject, next: nextProject } = getChronologicalNeighbors(projects, entry);
const isWork = Boolean(entry.data.workUrl && entry.data.work);
const workCover = entry.data.work?.cover;
const formatDate = (date: Date) => formatFullDate(date, locale);
const hasOutline = headings.filter((heading) => heading.depth === 2).length >= 2;
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<BaseLayout noindex={entry.data.draft} title={`${entry.data.title} — ${ui.brand}`} description={entry.data.description} type="article" pageKind="project" section="projects" articleTitle={entry.data.title} keywords={entry.data.tags} image={entry.data.hero?.src ?? entry.data.work?.cover} publishedAt={isoDate(publishedDate(entry))} updatedAt={entry.data.updatedAt && isoDate(entry.data.updatedAt)} repositoryUrl={entry.data.repositoryUrl} paperUrl={entry.data.paperUrl} status={entry.data.status} isWork={isWork}>
  <ReadingProgress />
  <article class="article shell"><header><p class="eyebrow">{isWork ? pageCopy.projectsDetail.work : pageCopy.projectsDetail.project} · {entry.data.status}</p><h1>{entry.data.title}</h1><p class="article-dek">{entry.data.description}</p><div class="article-dates"><AuthorByline locale={locale} /><time datetime={isoDate(publishedDate(entry))}>{isWork ? pageCopy.projectsDetail.collectedAt : pageCopy.projectsDetail.startedAt} {formatDate(publishedDate(entry))}</time>{entry.data.updatedAt && <span>{formatDate(entry.data.updatedAt)}</span>}{isWork ? <>{entry.data.work?.penName && <span>{entry.data.work?.penName}</span>}{entry.data.work?.platform && <span>{entry.data.work?.platform}</span>}{entry.data.work?.status && <span>{entry.data.work?.status}</span>}<a href={entry.data.workUrl} target="_blank" rel="noopener noreferrer">{pageCopy.projectsDetail.read} ↗</a></> : <a href={entry.data.repositoryUrl}>{pageCopy.projectsDetail.github} ↗</a>}{!isWork && entry.data.paperUrl && <a href={entry.data.paperUrl}>{pageCopy.projectsDetail.systemDesignPaper} ↗</a>}</div><TagList tags={entry.data.tags} locale={locale} indexableTags={indexableTags} class="article-tags" /></header>{workCover ? <figure class="project-hero work-cover"><img src={workCover} alt={pageCopy.projectsDetail.coverAlt(entry.data.title)} decoding="async" /></figure> : isWork ? <div class="work-cover-placeholder" aria-hidden="true"><span>《{entry.data.title}》</span><em>{pageCopy.projectsDetail.coverPlaceholder}</em></div> : entry.data.hero && <figure class="project-hero"><img src={entry.data.hero.src} alt={entry.data.hero.alt} decoding="async" />{entry.data.hero.caption && <figcaption>{entry.data.hero.caption}</figcaption>}</figure>}<div class="article-body">{hasOutline && <TableOfContents headings={headings} locale={locale} />}<div class="prose"><Content /></div></div>{entry.data.support && <TipCard locale={locale} variant="project" />}<ShareRow locale={locale} title={entry.data.title} url={shareUrl} type="project" /><RssSubscribe locale={locale} />{(previousProject || nextProject) && <nav class="post-pagination" aria-label={ui.postNav.prev || ui.postNav.next}><div class="pagination-col">{previousProject && <a class="prev" href={projectUrl(previousProject.id, locale)}><span class="nav-label">{ui.postNav.prev}</span><span class="nav-title">{previousProject.data.title}</span></a>}</div><div class="pagination-col">{nextProject && <a class="next" href={projectUrl(nextProject.id, locale)}><span class="nav-label">{ui.postNav.next}</span><span class="nav-title">{nextProject.data.title}</span></a>}</div></nav>}<Comments lang={locale} />{relatedEntries.length > 0 && <RelatedEntries items={relatedEntries} locale={locale} />}</article>
</BaseLayout>
