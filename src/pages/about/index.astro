---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { i18n } from '../../i18n/index.mjs';
import { site } from '../../data/site.mjs';
import { publishedIn } from '../../lib/content-model.ts';
const locale = Astro.currentLocale ?? 'zh-CN';
const ui = i18n(locale);
const copy = ui.page.about;
const url = (p: string) => getRelativeLocaleUrl(locale, p);
const email = site.email;
const [writing, research, projects] = await Promise.all([
  getCollection('writing', publishedIn(locale)),
  getCollection('research', publishedIn(locale)),
  getCollection('project', publishedIn(locale)),
]);
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription}>
  <section class="page-heading shell about"><p class="eyebrow">{copy.label}</p><h1>{copy.title[0]}<br />{copy.title[1]}</h1><p>{copy.description}</p><p class="about-intro">{copy.intro}</p><p class="about-stats">{copy.stats(writing.length, research.length, projects.length)}</p></section>

  <section class="shell section about-map" aria-labelledby="about-map-heading">
    <p class="eyebrow">{copy.mapEyebrow}</p>
    <h2 id="about-map-heading">{copy.mapTitle}</h2>
    <div class="about-map-grid">
      {(['writing', 'projects', 'research', 'fiction'] as const).map((key) => (
        <a class="about-map-card" href={url(copy.map[key].url)}>
          <strong>{copy.map[key].title}</strong>
          <span>{copy.map[key].desc}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell section about-fiction" aria-labelledby="about-fiction-heading">
    <p class="eyebrow">{copy.fictionEyebrow}</p>
    <h2 id="about-fiction-heading">{copy.fictionTitle}</h2>
    <p class="about-fiction-desc">{copy.fictionDesc}</p>
    <div class="about-novel-list">
      {copy.fictionNovels.map((novel) => (
        <a class="about-novel" href={url(novel.url)}>
          <strong>{novel.title}</strong>
          <span>{novel.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell section about-cooperate" aria-labelledby="about-cooperate-heading">
    <p class="eyebrow">{copy.cooperateEyebrow}</p>
    <h2 id="about-cooperate-heading">{copy.cooperateTitle}</h2>
    <p class="about-cooperate-desc">{copy.cooperateDesc}</p>
    <ul class="about-cooperate-list">
      {copy.cooperateItems.map((item) => (
        <li>
          <strong>{item.title}</strong>
          <span>{item.desc}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="shell section about-contact" aria-labelledby="about-contact-heading">
    <p class="eyebrow">{copy.contactEyebrow}</p>
    <h2 id="about-contact-heading">{copy.contactTitle}</h2>
    <ul class="about-contact-list">
      <li><a class="text-link" href={`mailto:${email}`}>{ui.footer.email} <span aria-hidden="true">↗</span></a></li>
      <li><a class="text-link" href={site.social.x} target="_blank" rel="noopener">{ui.footer.x} <span aria-hidden="true">↗</span></a></li>
      <li><a class="text-link" href={site.social.linkedin} target="_blank" rel="noopener">{ui.footer.linkedin} <span aria-hidden="true">↗</span></a></li>
      <li><a class="text-link" href={site.social.github} target="_blank" rel="noopener">{ui.footer.github} <span aria-hidden="true">↗</span></a></li>
    </ul>
  </section>

  <section class="shell section about-boundary">
    <p class="eyebrow">{copy.boundaryEyebrow}</p>
    <p>{copy.boundary}</p>
  </section>

  <section class="shell section about-guestbook">
    <p class="eyebrow">{copy.guestbookEyebrow}</p>
    <h2>{copy.guestbookTitle}</h2>
    <p>{copy.guestbookDesc}</p>
    <Comments lang={locale} term="guestbook" />
  </section>
</BaseLayout>
