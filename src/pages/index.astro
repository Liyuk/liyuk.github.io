---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import { publishedIn } from '../lib/content-model.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import RssSubscribe from '../components/RssSubscribe.astro';
import { i18n } from '../i18n/index.mjs';
import { site } from '../data/site.mjs';
import { formatFullDate, isoDate } from '../lib/format-dates.ts';
import { publishedDate, sortByCreatedAt } from '../lib/timeline.ts';
import { contentUrl } from '../lib/content-paths.ts';

const HOME_POSTS = 3;
const HOME_FEATURED = 3;

const locale = Astro.currentLocale ?? 'zh-CN';
const published = publishedIn(locale);
const writing = sortByCreatedAt(await getCollection('writing', published));
const latest = writing.slice(0, HOME_POSTS);
const latestIds = new Set(latest.map((entry) => entry.id));
const featured = sortByCreatedAt(await getCollection('writing', (entry) => published(entry) && entry.data.featured === true))
  .filter((entry) => !latestIds.has(entry.id))
  .slice(0, HOME_FEATURED);
const projects = sortByCreatedAt(await getCollection('project', published));
const latestProject = projects[0];
const projectCount = projects.length;
const researchCount = (await getCollection('research', published)).length;
const copy = i18n(locale).page.home;
const path = (p: string) => getRelativeLocaleUrl(locale, p);
---

<BaseLayout title={copy.metaTitle} description={copy.description} seoPage="home">
  <section class="hero shell">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title[0]}<br />{copy.title[1]}</h1>
    <div class="hero-copy">
      <p class="hero-byline">{copy.byline}</p>
      <p>{copy.description}</p>
      <a class="text-link" href={path('/about/')}>{copy.aboutLink} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={`mailto:${site.email}`}>{copy.contact}: {site.email} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section shell start-callout" aria-labelledby="start-heading">
    <p class="eyebrow">{copy.start.eyebrow}</p><h2 id="start-heading">{copy.start.title}</h2><p>{copy.start.description}</p><a class="text-link" href={path('/start/')}>{copy.start.link} <span aria-hidden="true">↗</span></a>
  </section>

  <section class="section shell home-projects" aria-labelledby="home-projects-heading">
    <div class="home-projects-heading">
      <div><p class="eyebrow">{copy.projects.eyebrow}</p><h2 id="home-projects-heading">{copy.projects.title}</h2></div>
      <a class="text-link" href={path('/projects/')}>{copy.projects.link} <span aria-hidden="true">↗</span></a>
    </div>
    {latestProject ? (
      <article class="entry-card home-project-card">
        <div class="entry-meta"><span>{latestProject.data.status}</span><time datetime={isoDate(publishedDate(latestProject))}>{copy.projects.published} {formatFullDate(publishedDate(latestProject), locale)}</time></div>
        <h3><a href={contentUrl('project', latestProject.id, locale)}>{latestProject.data.title}</a></h3>
        <p>{latestProject.data.description}</p>
      </article>
    ) : <p>{copy.projects.empty}</p>}
  </section>

  <section class="section shell split-section" aria-labelledby="writing-heading">
    <div class="section-intro">
      <p class="eyebrow">{copy.writing.eyebrow}</p>
      <h2 id="writing-heading">{copy.writing.title[0]}<br />{copy.writing.title[1]}</h2>
      <p class="writing-scale">{copy.writing.archiveHint(writing.length)}</p>
      <a class="text-link" href={path('/writing/')}>{copy.writing.link} <span aria-hidden="true">↗</span></a>
      <RssSubscribe locale={locale} />
    </div>
    <div class="entry-list">
      <h3 class="entry-list-heading">{copy.writing.latest}</h3>
      {latest.length ? latest.map((entry) => <EntryCard entry={entry} locale={locale} />) : <p>{copy.writing.empty}</p>}
      {featured.length > 0 && (
        <>
          <h3 class="entry-list-heading">{copy.writing.featured}</h3>
          {featured.map((entry) => <EntryCard entry={entry} locale={locale} />)}
        </>
      )}
    </div>
  </section>

  <section class="section shell practice-grid" aria-label={copy.practiceGridAria}>
    <a href={path('/projects/')} class="practice-card"><span>{copy.practices.projects.label}</span><strong>{copy.practices.projects.title}</strong><em>{copy.practices.projects.description}</em><small>{copy.practices.projects.count(projectCount)}</small></a>
    <a href={path('/research/')} class="practice-card"><span>{copy.practices.research.label}</span><strong>{copy.practices.research.title}</strong><em>{copy.practices.research.description}</em><small>{copy.practices.research.count(researchCount)}</small></a>
    <a href={path('/consulting/')} class="practice-card"><span>{copy.practices.consulting.label}</span><strong>{copy.practices.consulting.title}</strong><em>{copy.practices.consulting.description}</em><small>{copy.practices.consulting.cta}</small></a>
  </section>

</BaseLayout>
