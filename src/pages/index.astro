---
import { getCollection } from 'astro:content';
import { publishedFilter } from '../lib/content-model.mjs';
import { localeFromPath, localizePath } from '../lib/locale-url.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import { site } from '../data/site.mjs';
import { getPageCopy } from '../i18n/page-copy.mjs';
import { sortByCreatedAt } from '../lib/timeline.mjs';

const locale = localeFromPath(Astro.url.pathname);
const writing = sortByCreatedAt(await getCollection('writing', publishedFilter));
const copy = getPageCopy(locale).home;
const path = (p) => localizePath(p, locale);
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title[0]}<br />{copy.title[1]}</h1>
    <div class="hero-copy">
      <p class="hero-byline">{copy.byline}</p>
      <p>{copy.description}</p>
      <a class="text-link" href={path('/about/')}>{copy.aboutLink} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section shell split-section" aria-labelledby="writing-heading">
    <div class="section-intro">
      <p class="eyebrow">{copy.writing.eyebrow}</p>
      <h2 id="writing-heading">{copy.writing.title[0]}<br />{copy.writing.title[1]}</h2>
      <a class="text-link" href={path('/writing/')}>{copy.writing.link} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="entry-list">
      {writing.length ? writing.slice(0, 3).map((entry) => <EntryCard entry={entry} locale={locale} />) : <p>{copy.writing.empty}</p>}
    </div>
  </section>

  <section class="section shell practice-grid" aria-label={copy.practiceGridAria}>
    <a href={path('/projects/')} class="practice-card"><span>{copy.practices.projects.label}</span><strong>{copy.practices.projects.title}</strong><em>{copy.practices.projects.description}</em></a>
    <a href={path('/research/')} class="practice-card"><span>{copy.practices.research.label}</span><strong>{copy.practices.research.title}</strong><em>{copy.practices.research.description}</em></a>
    <a href={path('/photos/')} class="practice-card photo-card"><span>{copy.practices.photos.label}</span><strong>{copy.practices.photos.title}</strong><em>{copy.practices.photos.description}</em></a>
  </section>

  <section class="section shell start-callout">
    <p class="eyebrow">{copy.start.eyebrow}</p><h2>{copy.start.title}</h2><p>{copy.start.description}</p><a class="text-link" href={path('/start/')}>{copy.start.link} <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
