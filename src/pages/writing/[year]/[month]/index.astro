---
import { getCollection } from 'astro:content';
import { notDraft } from '../../../../lib/content-model.ts';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EntryCard from '../../../../components/EntryCard.astro';
import { i18n } from '../../../../i18n/index.mjs';
import { groupByYearMonth } from '../../../../lib/timeline.ts';

export async function getStaticPaths() {
  const entries = await getCollection('writing', notDraft);
  return groupByYearMonth(entries).map(({ year, month, entries: archiveEntries }) => ({
    params: { year: String(year), month: String(month).padStart(2, '0') },
    props: { year, month, entries: archiveEntries },
  }));
}

const { year, month, entries } = Astro.props;
const locale = Astro.currentLocale ?? 'zh-CN';
const localEntries = entries.filter((entry) => entry.data.locale === locale);
const archive = i18n(locale).page.writingArchive;
const ui = i18n(locale);
---
<BaseLayout title={archive.metaTitle(year, archive.yearSuffix, ui.brand)} description={archive.description}>
  <section class="page-heading shell"><p class="eyebrow">{archive.eyebrow}</p><h1>{archive.titleMonth(year, archive.yearSuffix, month, archive.monthSuffix)}</h1><p>{archive.description}</p></section>
  <section class="shell entry-list archive-list">{localEntries.map((entry) => <EntryCard entry={entry} locale={locale} />)}</section>
</BaseLayout>
