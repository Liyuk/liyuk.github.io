---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ColumnCard from '../../components/ColumnCard.astro';
import TagList from '../../components/TagList.astro';
import TipCard from '../../components/TipCard.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import ShareRow from '../../components/ShareRow.astro';
import RssSubscribe from '../../components/RssSubscribe.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Comments from '../../components/Comments.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';
import { notDraft } from '../../lib/content-model.ts';
import { groupByLocaleVariant, pickLocaleVariant } from '../../lib/content-query.ts';
import { writingSlug } from '../../lib/content-paths.ts';
import { columnUrl, entryUrl, writingUrl } from '../../lib/content-paths.ts';
import { getColumn, getColumnEntries, getIndexableTags, getRelatedEntries, RELATED_LIMIT } from '../../lib/taxonomy.ts';
import { formatFullDate, isoDate } from '../../lib/format-dates.ts';
import { i18n } from '../../i18n/index.mjs';
import { publishedDate, getChronologicalNeighbors } from '../../lib/timeline.ts';
import { readingMinutes } from '../../lib/reading-time.ts';

export async function getStaticPaths() {
  const writing = await getCollection('writing', notDraft);
  return groupByLocaleVariant(writing, (entry) => writingSlug(entry.id)).map(({ slug, variants }) => ({
    params: { slug },
    props: { variants },
  }));
}

const { variants } = Astro.props;
const locale = Astro.currentLocale ?? 'zh-CN';
const entry = pickLocaleVariant(variants, locale)!;
const ui = i18n(locale);
const pageCopy = i18n(locale).page;
const { Content, headings } = await render(entry);
const allWriting = await getCollection('writing', ({ data }) => !data.draft && data.locale === entry.data.locale);
const allGalleries = await getCollection('gallery', ({ data }) => !data.draft && data.locale === entry.data.locale);
const indexableTags = getIndexableTags(allWriting).map(({ slug }) => slug);
const columnEntries = entry.data.column ? getColumnEntries([...allWriting, ...allGalleries], entry.data.column.slug) : [];
const columnIndex = columnEntries.findIndex((columnEntry) => columnEntry.id === entry.id);
const previousColumnEntry = columnEntries[columnIndex - 1];
const nextColumnEntry = columnEntries[columnIndex + 1];
const [allResearch, allProjects] = await Promise.all([
  getCollection('research', ({ data }) => !data.draft && data.locale === entry.data.locale),
  getCollection('project', ({ data }) => !data.draft && data.locale === entry.data.locale),
]);
const allEntries = [...allWriting, ...allResearch, ...allProjects, ...allGalleries];
const relatedEntries = getRelatedEntries(allEntries, entry, RELATED_LIMIT, locale);
const formatDate = (date: Date) => formatFullDate(date, locale);
// 时间序上一篇/下一篇（按发布时间，含打赏后导航）。与专栏章节导航分开：
// 专栏文章两者都显示——章节导航走专栏顺序，时间序导航走发布时间顺序。
const { previous: previousPost, next: nextPost } = getChronologicalNeighbors(allWriting, entry);
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
// Show the TOC only when there is a real outline: at least two h2 sections.
// (Previously gated on raw heading count, which could trigger on a long flat
// list of h3s while the TOC only ever renders depth ≤ 3.)
const hasOutline = headings.filter((heading) => heading.depth === 2).length >= 2;
---
<BaseLayout title={`${entry.data.title} — ${ui.name}`} description={entry.data.description} type="article" publishedAt={isoDate(publishedDate(entry))}>
  <ReadingProgress />
  <article class="article shell">
    <header><p class="eyebrow">{ui.navigation.writing}</p><h1>{entry.data.title}</h1><p class="article-dek" data-pagefind-meta="description">{entry.data.description}</p><div class="article-dates"><AuthorByline locale={locale} /><time datetime={isoDate(publishedDate(entry))}>{ui.entry.publishedAt} {formatDate(publishedDate(entry))}</time>{entry.data.updatedAt && <time datetime={isoDate(entry.data.updatedAt)}>{ui.entry.updatedAt} {formatDate(entry.data.updatedAt)}</time>}<span>{ui.entry.readingMinutes(readingMinutes(entry.body, locale))}</span></div><TagList tags={entry.data.tags} locale={locale} indexableTags={indexableTags} class="article-tags" pagefindFilter /></header>
    {entry.data.column && <ColumnCard entry={entry} columnSlug={entry.data.column.slug} locale={locale} allEntries={[...allWriting, ...allGalleries]} />}
    <div class="article-body">
      {hasOutline && <TableOfContents headings={headings} locale={locale} />}
      <div class="prose" data-pagefind-body><Content /></div>
    </div>
    <TipCard locale={locale} />
    <ShareRow locale={locale} title={entry.data.title} url={shareUrl} type="writing" />
    <RssSubscribe locale={locale} />
    {(previousPost || nextPost) && <nav class="post-pagination" aria-label={ui.postNav.prev || ui.postNav.next}><div class="pagination-col">{previousPost && <a class="prev" href={writingUrl(previousPost.id, locale)}><span class="nav-label">{ui.postNav.prev}</span><span class="nav-title">{previousPost.data.title}</span></a>}</div><div class="pagination-col">{nextPost && <a class="next" href={writingUrl(nextPost.id, locale)}><span class="nav-label">{ui.postNav.next}</span><span class="nav-title">{nextPost.data.title}</span></a>}</div></nav>}
    {entry.data.column && <nav class="column-pagination" aria-label={ui.entry.columnChaptersAria}><a href={columnUrl(entry.data.column.slug, locale)}>{pageCopy.columnsDetail.viewDirectory(getColumn(entry.data.column.slug, locale)?.label ?? '')}</a>{previousColumnEntry && <a href={entryUrl(previousColumnEntry, locale)}>{pageCopy.columnsDetail.prev(previousColumnEntry.data.title)}</a>}{nextColumnEntry && <a href={entryUrl(nextColumnEntry, locale)}>{pageCopy.columnsDetail.next(nextColumnEntry.data.title)}</a>}</nav>}
    <Comments lang={locale} />
    {relatedEntries.length > 0 && <RelatedEntries items={relatedEntries} locale={locale} />}
  </article>
</BaseLayout>
