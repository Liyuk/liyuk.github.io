---
import { getCollection } from 'astro:content';
import ArchiveSection from '../../../components/ArchiveSection.astro';
import { notDraft } from '../../../lib/content-model.ts';
import { groupByYear } from '../../../lib/timeline.ts';
import { i18n } from '../../../i18n/index.mjs';

export async function getStaticPaths() {
  return groupByYear(await getCollection('research', notDraft)).map(({ year, entries }) => ({ params: { year: String(year) }, props: { year, entries } }));
}

const { year, entries } = Astro.props;
const locale = Astro.currentLocale ?? 'zh-CN';
const localEntries = entries.filter((entry) => entry.data.locale === locale);
---

<ArchiveSection collection="research" entries={localEntries} label={i18n(locale).page.tagCards.research.label} action={i18n(locale).page.tagCards.research.action} kind="year" year={year} />
