---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { i18n } from '../../i18n/index.mjs';
import { getCollection } from 'astro:content';
import { galleryUrl } from '../../lib/content-paths.ts';
import { getGalleryCover } from '../../lib/gallery.ts';
import { publishedIn } from '../../lib/content-model.ts';
import { sortByCreatedAt } from '../../lib/timeline.ts';

// Progressive reveal rather than real pagination: every gallery stays in the
// DOM (good for crawling), and a button unveils the next batch. Kept small
// since the collection is young.
const PHOTOS_PER_BATCH = 6;

const locale = Astro.currentLocale ?? 'zh-CN';
const copy = i18n(locale).page.photos;
const ui = i18n(locale);
const galleries = sortByCreatedAt(await getCollection('gallery', publishedIn(locale)));
const hasMore = galleries.length > PHOTOS_PER_BATCH;
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription}>
  <section class="page-heading shell"><p class="eyebrow">{copy.label}</p><h1>{copy.title[0]}<br />{copy.title[1]}</h1><p>{copy.description}</p></section>
  {galleries.length > 0 ? (
    <section class="shell gallery-masonry" aria-label={copy.label} data-photos-masonry>
      {galleries.map((gallery, index) => {
        const cover = getGalleryCover(gallery);
        const initiallyHidden = index >= PHOTOS_PER_BATCH;
        return <a class:list={['gallery-card', { 'gallery-card--hidden': initiallyHidden }]} href={galleryUrl(gallery.data.slug, locale)}>
          <span class="gallery-card-figure"><img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" /></span>
          <span class="gallery-card-copy"><strong>{gallery.data.title}</strong><em>{gallery.data.description}</em><small>{ui.count.photos(gallery.data.images.length)}</small></span>
        </a>;
      })}
    </section>
  ) : <section class="shell photo-placeholder" aria-label={copy.placeholderLabel}><span>{copy.placeholder}</span></section>}
  {hasMore && <div class="shell photos-load-more"><button type="button" class="photos-load-more-btn" data-photos-more>{ui.photosLoadMore.label}</button></div>}
</BaseLayout>

<script define:vars={{ batch: PHOTOS_PER_BATCH, doneLabel: ui.photosLoadMore.done }}>
  const masonry = document.querySelector<HTMLElement>('[data-photos-masonry]');
  const button = document.querySelector<HTMLButtonElement>('[data-photos-more]');
  if (masonry && button) {
    const cards = [...masonry.querySelectorAll<HTMLElement>('.gallery-card')];
    const hidden = () => cards.filter((card) => card.classList.contains('gallery-card--hidden'));
    button.addEventListener('click', () => {
      hidden().slice(0, batch).forEach((card) => card.classList.remove('gallery-card--hidden'));
      if (hidden().length === 0) {
        button.textContent = doneLabel;
        button.disabled = true;
      }
    });
  }
</script>
