---
import { getRelativeLocaleUrl } from 'astro:i18n';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteChat from '../components/SiteChat.astro';
import { site } from '../data/site.mjs';
import { i18n } from '../i18n/index.mjs';
import { getPageSeo, type SeoPage } from '../lib/seo.ts';
import { buildStructuredData, type PageKind, type StructuredDataImage } from '../lib/structured-data.ts';

const {
  title: titleProp,
  description: descriptionProp,
  locale = Astro.currentLocale ?? 'zh-CN',
  showLanguageSwitch = true,
  noindex = false,
  // GitHub Pages serves `404.html` at whatever URL the reader typed, so that
  // page has no canonical URL of its own — declaring one points at a route
  // that does not exist. Every real route keeps its canonical.
  canonical = true,
  seoPage,
  // Social-share metadata. Detail pages pass these; list/home pages omit them
  // and fall back to the site defaults below.
  type = 'website',
  image,
  publishedAt,
  updatedAt,
  articleTitle,
  keywords = [],
  pageKind = type === 'article' ? 'writing' : 'website',
  section,
  citations = [],
  repositoryUrl,
  paperUrl,
  status,
  version,
  isWork = false,
  galleryImages = [],
  // Ordered members of a curated list page (currently a column's chapters).
  itemList = [],
} = Astro.props as {
  title?: string;
  description?: string;
  locale?: string;
  showLanguageSwitch?: boolean;
  noindex?: boolean;
  canonical?: boolean;
  seoPage?: SeoPage;
  type?: string;
  image?: string;
  publishedAt?: string;
  updatedAt?: string;
  articleTitle?: string;
  keywords?: string[];
  pageKind?: PageKind;
  section?: string;
  citations?: string[];
  repositoryUrl?: string;
  paperUrl?: string;
  status?: string;
  version?: string;
  isWork?: boolean;
  galleryImages?: StructuredDataImage[];
  itemList?: { name: string; url: string }[];
};
const ui = i18n(locale);
const pageCopy = i18n(locale).page;
const isEnglish = locale === 'en';
const pageSeo = seoPage ? getPageSeo(locale, seoPage) : undefined;
// Locale-aware fallbacks so a page that omits its own title/description never
// leaks the Chinese site defaults onto an English route.
const title = titleProp ?? (isEnglish ? site.titleEn : site.title);
const description = pageSeo?.description ?? descriptionProp ?? (isEnglish ? site.descriptionEn : site.description);
const resolvedKeywords = keywords.length > 0 ? keywords : pageSeo?.keywords ?? [];
const rootPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '');
const zhUrl = new URL(getRelativeLocaleUrl('zh-CN', rootPath), Astro.site);
const enUrl = new URL(getRelativeLocaleUrl('en', rootPath), Astro.site);
const defaultUrl = zhUrl;
// Canonical URL for social tags: use the canonical (locale) URL we already
// compute, resolved against the configured site.
const canonicalUrl = new URL(isEnglish ? enUrl : zhUrl, Astro.site).href;
// og:image falls back to the brand card; detail pages may override with a
// project hero / gallery cover.
const ogImage = image ? new URL(image, Astro.site).href : new URL('/images/og-default.png', Astro.site).href;
const ogType = type;
const ogLocale = isEnglish ? 'en_US' : 'zh_CN';
---

<!doctype html>
<html lang={locale} class:list={[isEnglish ? 'locale-en' : 'locale-zh']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {publishedAt && <meta data-pagefind-meta="publishedAt[content]" content={publishedAt} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f4f1ea" />
    <meta name="google-site-verification" content="FXPD4M6ETfaWY-qsVu1YiYLmKJFrFO28w6ya3odrNok" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={isEnglish ? enUrl : zhUrl} />}
    {!noindex && <>
      <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
      <link rel="alternate" hreflang="en" href={enUrl} />
      <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    </>}
    <link rel="alternate" type="application/rss+xml" title={`${pageCopy.rss.title} RSS`} href={isEnglish ? '/en/rss.xml' : '/rss.xml'} />
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem('liyuk-theme');
        if (storedTheme === 'light' || storedTheme === 'dark') {
          document.documentElement.dataset.theme = storedTheme;
        }
      } catch {
        // The system color scheme remains active when storage is unavailable.
      }
    </script>
    <title>{title}</title>
    <!-- Open Graph (Facebook / LinkedIn / iMessage / WhatsApp …) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={isEnglish ? site.brandEn : site.brand} />
    {resolvedKeywords.length > 0 && <meta name="keywords" content={resolvedKeywords.join(', ')} />}
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Structured data graph: stable site entities plus the page's typed content node. -->
    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(buildStructuredData({
      origin: Astro.site?.origin ?? 'https://liyuk.com',
      locale,
      canonicalUrl,
      title: articleTitle ?? title,
      description,
      pageKind,
      section,
      image: ogImage,
      galleryImages,
      publishedAt,
      updatedAt,
      keywords: resolvedKeywords,
      citations,
      itemList,
      repositoryUrl,
      paperUrl,
      status,
      version,
      isWork,
    }))} />}
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "3fce6f5df2fd44549cddc9a34e63d7e4"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#content">{ui.accessibility.skipToContent}</a>
    <Header currentPath={Astro.url.pathname} locale={locale} showLanguageSwitch={showLanguageSwitch} />
    <main id="content"><slot /></main>
    <Footer locale={locale} />
    <SiteChat locale={locale} />
    <p class="visually-hidden" id="ux-live" role="status" aria-live="polite"></p>
    <script is:inline define:vars={{ ux: { copy: ui.ux.copy, copied: ui.ux.copied, copyCode: ui.ux.copyCode, copiedCode: ui.ux.copiedCode, copySection: ui.ux.copySection, sectionCopied: ui.ux.sectionCopied } }}>
      (() => {
        const live = document.getElementById('ux-live');
        const announce = (message) => {
          if (!live) return;
          live.textContent = '';
          requestAnimationFrame(() => { live.textContent = message; });
        };
        const copyText = async (text) => {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            const area = document.createElement('textarea');
            area.value = text;
            area.setAttribute('readonly', '');
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.append(area);
            area.select();
            let ok = false;
            try { ok = document.execCommand('copy'); } catch { ok = false; }
            area.remove();
            return ok;
          }
        };

        // Code blocks: wrap each fenced block and add a copy button (Mermaid renders to SVG, KaTeX is not <pre>).
        document.querySelectorAll('.prose pre').forEach((pre) => {
          if (pre.closest('.code-block') || pre.classList.contains('mermaid')) return;
          const wrap = document.createElement('div');
          wrap.className = 'code-block';
          pre.parentNode.insertBefore(wrap, pre);
          wrap.append(pre);
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'code-copy';
          button.textContent = ux.copy;
          button.setAttribute('aria-label', ux.copyCode);
          let timer;
          button.addEventListener('click', async () => {
            const ok = await copyText(pre.textContent || '');
            if (!ok) return;
            button.textContent = ux.copied;
            announce(ux.copiedCode);
            clearTimeout(timer);
            timer = setTimeout(() => { button.textContent = ux.copy; }, 1800);
          });
          wrap.append(button);
        });

        // Heading anchors: h2/h3 with ids get a # link that copies the section URL.
        document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((heading) => {
          const link = document.createElement('a');
          link.className = 'heading-anchor';
          link.href = `#${heading.id}`;
          link.textContent = '#';
          link.setAttribute('aria-label', `${ux.copySection}: ${heading.textContent}`);
          link.addEventListener('click', async (event) => {
            event.preventDefault();
            const url = `${location.origin}${location.pathname}${location.search}#${heading.id}`;
            history.replaceState(null, '', `#${heading.id}`);
            heading.scrollIntoView();
            if (await copyText(url)) announce(ux.sectionCopied);
          });
          heading.append(link);
        });

        // Keyboard: "/" focuses search; "[" and "]" move between posts.
        document.addEventListener('keydown', (event) => {
          if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
          const target = event.target;
          if (target instanceof HTMLElement && target.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"]')) return;
          if (document.querySelector('dialog[open], [role="dialog"]:not([hidden])')) return;
          if (event.key === '/') {
            const input = document.getElementById('site-search');
            if (input) {
              event.preventDefault();
              input.focus();
            } else {
              const link = document.querySelector('[data-search-link]');
              if (link) {
                event.preventDefault();
                location.href = link.href;
              }
            }
          } else if (event.key === '[' || event.key === ']') {
            const cls = event.key === '[' ? 'prev' : 'next';
            const link = [...document.querySelectorAll(`.column-pagination a.${cls}, .post-pagination a.${cls}`)].find((a) => a.offsetParent !== null);
            if (link) location.href = link.href;
          }
        });
      })();
    </script>
    <script>
      // Thread-and-node reading state: fill nodes for articles read in this
      // browser, and mark the current article read once the reader reaches
      // ~80% of it (or the end). Only pages with a [data-read-track] marker
      // (long-form detail pages) are recorded.
      import { markRead, paintReadNodes } from '../lib/read-state.ts';

      paintReadNodes();
      if (document.querySelector('[data-read-track]')) {
        let done = false;
        let ticking = false;
        const check = () => {
          ticking = false;
          if (done) return;
          const root = document.documentElement;
          const total = root.scrollHeight - root.clientHeight;
          const reached = total <= 0 || window.scrollY / total >= 0.8 || window.innerHeight + window.scrollY >= root.scrollHeight - 4;
          if (!reached) return;
          done = true;
          markRead(location.pathname);
          window.removeEventListener('scroll', onScroll);
          paintReadNodes();
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(check);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        // Short pages that do not scroll count as read after a brief look.
        window.setTimeout(check, 4000);
      }
    </script>
  </body>
</html>
