---
import { getRelativeLocaleUrl } from 'astro:i18n';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.mjs';
import { i18n } from '../i18n/index.mjs';

const {
  title: titleProp,
  description: descriptionProp,
  locale = Astro.currentLocale ?? 'zh-CN',
  noindex = false,
  // Social-share metadata. Detail pages pass these; list/home pages omit them
  // and fall back to the site defaults below.
  type = 'website',
  image,
  publishedAt,
} = Astro.props;
const ui = i18n(locale);
const pageCopy = i18n(locale).page;
const isEnglish = locale === 'en';
// Locale-aware fallbacks so a page that omits its own title/description never
// leaks the Chinese site defaults onto an English route.
const title = titleProp ?? (isEnglish ? site.titleEn : site.title);
const description = descriptionProp ?? (isEnglish ? site.descriptionEn : site.description);
const rootPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '');
const zhUrl = new URL(getRelativeLocaleUrl('zh-CN', rootPath), Astro.site);
const enUrl = new URL(getRelativeLocaleUrl('en', rootPath), Astro.site);
const defaultUrl = isEnglish ? new URL('/', Astro.site) : new URL(Astro.url.pathname, Astro.site);
// Canonical URL for social tags: use the canonical (locale) URL we already
// compute, resolved against the configured site.
const canonicalUrl = new URL(isEnglish ? enUrl : zhUrl, Astro.site).href;
// og:image falls back to the brand card; detail pages may override with a
// project hero / gallery cover.
const ogImage = image ? new URL(image, Astro.site).href : new URL('/images/og-default.png', Astro.site).href;
const ogType = type;
const ogLocale = isEnglish ? 'en_US' : 'zh_CN';
---

<!doctype html>
<html lang={locale} class:list={[isEnglish ? 'locale-en' : 'locale-zh']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={isEnglish ? enUrl : zhUrl} />
    {!noindex && <>
      <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
      <link rel="alternate" hreflang="en" href={enUrl} />
      <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    </>}
    <link rel="alternate" type="application/rss+xml" title={`${pageCopy.rss.title} RSS`} href={isEnglish ? '/en/rss.xml' : '/rss.xml'} />
    <script is:inline>
      const storedTheme = localStorage.getItem('liyuk-theme');
      if (storedTheme) document.documentElement.dataset.theme = storedTheme;
    </script>
    <title>{title}</title>
    <!-- Open Graph (Facebook / LinkedIn / iMessage / WhatsApp …) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={isEnglish ? site.nameEn : site.brand} />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Article structured data (Google rich results / Discover) -->
    {ogType === 'article' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: ogImage,
        datePublished: publishedAt ?? undefined,
        author: { '@type': 'Person', name: site.name },
        publisher: { '@type': 'Organization', name: site.brand },
      })} />
    )}
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "3fce6f5df2fd44549cddc9a34e63d7e4"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#content">{ui.accessibility.skipToContent}</a>
    <Header currentPath={Astro.url.pathname} locale={locale} />
    <main id="content"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
