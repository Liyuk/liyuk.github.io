---
import { getRelativeLocaleUrl } from 'astro:i18n';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.mjs';
import { i18n } from '../i18n/index.mjs';

const {
  title: titleProp,
  description: descriptionProp,
  locale = Astro.currentLocale ?? 'zh-CN',
  noindex = false,
} = Astro.props;
const ui = i18n(locale);
const pageCopy = i18n(locale).page;
const isEnglish = locale === 'en';
// Locale-aware fallbacks so a page that omits its own title/description never
// leaks the Chinese site defaults onto an English route.
const title = titleProp ?? (isEnglish ? site.titleEn : site.title);
const description = descriptionProp ?? (isEnglish ? site.descriptionEn : site.description);
const rootPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '');
const zhUrl = new URL(getRelativeLocaleUrl('zh-CN', rootPath), Astro.site);
const enUrl = new URL(getRelativeLocaleUrl('en', rootPath), Astro.site);
const defaultUrl = isEnglish ? new URL('/', Astro.site) : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={isEnglish ? enUrl : zhUrl} />
    {!noindex && <>
      <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
      <link rel="alternate" hreflang="en" href={enUrl} />
      <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    </>}
    <link rel="alternate" type="application/rss+xml" title={`${pageCopy.rss.title} RSS`} href={isEnglish ? '/en/rss.xml' : '/rss.xml'} />
    <script is:inline>
      const storedTheme = localStorage.getItem('liyuk-theme');
      if (storedTheme) document.documentElement.dataset.theme = storedTheme;
    </script>
    <title>{title}</title>
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c23ada27d5ac4a998ba3d64fbd8cfc93"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#content">{ui.accessibility.skipToContent}</a>
    <Header currentPath={Astro.url.pathname} locale={locale} />
    <main id="content"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
