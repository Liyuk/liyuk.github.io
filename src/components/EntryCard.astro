---
import { contentUrl, writingUrl } from '../lib/content-paths.ts';
import { getColumn } from '../lib/taxonomy.ts';
import { formatFullDate, isoDate } from '../lib/format-dates.ts';
import { i18n } from '../i18n/index.mjs';
import { publishedDate, lastUpdatedDate } from '../lib/timeline.ts';
import { readingMinutes } from '../lib/reading-time.ts';
import TagList from './TagList.astro';

const MAX_CARD_TAGS = 3;

const { entry, indexableTags = [], locale: localeProp, urlPrefix = 'writing' } = Astro.props;
const locale = localeProp ?? entry.data.locale ?? Astro.currentLocale ?? 'zh-CN';
const ui = i18n(locale);
const published = publishedDate(entry);
const date = formatFullDate(published, locale);
const lastUpdated = lastUpdatedDate(entry);
const lastUpdatedDateStr = formatFullDate(lastUpdated, locale);
// `writing` classifies itself with `type`; every other collection rendered by
// this card (currently `consulting`) is labelled by its collection instead.
const typeKey = entry.collection === 'writing' ? entry.data.type : entry.collection;
const entryType = ui.entry.types[typeKey as keyof typeof ui.entry.types] ?? typeKey;
const lastUpdatedLabel = entry.data.updatedAt ? `${ui.entry.updatedAt} ${lastUpdatedDateStr}` : `${ui.entry.publishedAt} ${lastUpdatedDateStr}`;
---

<article class="entry-card" data-published-at={isoDate(published)} data-last-updated-at={isoDate(lastUpdated)} data-published-label={`${ui.entry.publishedAt} ${date}`} data-last-updated-label={lastUpdatedLabel}>
  <div class="entry-meta"><time data-entry-date datetime={isoDate(published)}>{ui.entry.publishedAt} {date}</time></div>
  <h2><a href={urlPrefix === 'writing' ? writingUrl(entry.id, locale) : contentUrl(urlPrefix, entry.id, locale)}>{entry.data.title}</a></h2>
  <p>{entry.data.description}</p>
  <p class="entry-type">{entryType}</p>
  <p class="entry-reading">{ui.entry.readingMinutes(readingMinutes(entry.body, locale))}</p>
  {entry.data.column && <p class="column-reference">{ui.entry.columnIn(getColumn(entry.data.column.slug, locale)?.label ?? entry.data.column.slug, entry.data.column.order)}</p>}
  <TagList tags={entry.data.tags} locale={locale} indexableTags={indexableTags} max={MAX_CARD_TAGS} />
</article>
