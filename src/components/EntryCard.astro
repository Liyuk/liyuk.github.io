---
import { columnUrl, tagUrl, writingUrl } from '../lib/content-paths.mjs';
import { getColumn, getTag } from '../lib/taxonomy.mjs';
import { localeFromPath } from '../lib/locale-url.mjs';
import { formatFullDate, isoDate } from '../lib/format-dates.mjs';
import { getUiCopy } from '../i18n/ui.mjs';
import { publishedDate, lastUpdatedDate } from '../lib/timeline.mjs';
const { entry, indexableTags = [], locale: localeProp } = Astro.props;
const locale = localeProp ?? entry.data.locale ?? localeFromPath(Astro.url.pathname);
const ui = getUiCopy(locale);
const published = publishedDate(entry);
const date = formatFullDate(published, locale);
const lastUpdated = lastUpdatedDate(entry);
const lastUpdatedDateStr = formatFullDate(lastUpdated, locale);
const lastUpdatedLabel = entry.data.updatedAt ? `${ui.entry.updatedAt} ${lastUpdatedDateStr}` : `${ui.entry.publishedAt} ${lastUpdatedDateStr}`;
---

<article class="entry-card" data-published-at={isoDate(published)} data-last-updated-at={isoDate(lastUpdated)} data-published-label={`${ui.entry.publishedAt} ${date}`} data-last-updated-label={lastUpdatedLabel}>
  <div class="entry-meta"><time data-entry-date datetime={isoDate(published)}>{ui.entry.publishedAt} {date}</time></div>
  <h2><a href={writingUrl(entry.id, locale)}>{entry.data.title}</a></h2>
  <p>{entry.data.description}</p>
  {entry.data.column && <p class="column-reference">{ui.entry.columnIn(getColumn(entry.data.column.slug, locale)?.label ?? entry.data.column.slug, entry.data.column.order)}</p>}
  {entry.data.tags?.length > 0 && <ul class="tag-list" aria-label={ui.entry.tagsAria}>{entry.data.tags.slice(0, 3).map((slug) => <li>{indexableTags.includes(slug) ? <a href={tagUrl(slug, locale)}>#{getTag(slug, locale).label}</a> : <span>#{getTag(slug, locale).label}</span>}</li>)}</ul>}
  <a class="text-link" href={writingUrl(entry.id, locale)}>{ui.entry.readFull} <span aria-hidden="true">↗</span></a>
</article>
