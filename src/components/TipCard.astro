---
// 打赏卡片（默认展开的可见卡片，参考 irisluan.com 的 Buy-Me-A-Coffee 结构）。
//
// 结构（中英文一致）：一张常显卡片 = ☕ + 话术 + 按钮。
//   - 中文页：卡片里两个按钮「微信」「支付宝」，各自悬浮（hover）或点按时在
//     按钮上方弹出对应的收款码二维码弹层；点外部 / Esc 关闭（移动端点按）。
//   - 英文页：卡片里一个 PayPal 按钮，点击直接跳转 paypal.me 支付页
//     （英文读者用 PayPal 直链更顺滑，符合 Buy-Me-A-Coffee 惯例；二维码需另
//     装 PayPal App 扫码，摩擦更大，故英文用直链、中文用支付码）。
import { i18n } from '../i18n/index.mjs';

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale ?? 'zh-CN' } = Astro.props as Props;
const t = i18n(locale).tip;
const isEnglish = locale === 'en';
const tipLink = 'https://paypal.me/liyuk7';

// 中文的两个收款渠道。
const channels = [
  { key: 'wechat', img: '/images/tip/wechat-pay.webp', name: t.wechat },
  { key: 'alipay', img: '/images/tip/alipay.webp', name: t.alipay },
];
---

<section class="tip-card" data-tip-card>
  <div class="tip-emoji" aria-hidden="true">☕</div>
  <p class="tip-desc">{t.description}</p>

  {isEnglish ? (
    <a class="tip-btn tip-btn-primary" href={tipLink} target="_blank" rel="noopener">{t.action} →</a>
  ) : (
    <div class="tip-actions">
      {channels.map((ch) => (
        <div class="tip-btn-wrap" data-tip-wrap>
          <button class="tip-btn" type="button" aria-expanded="false" aria-controls={`tip-qr-${ch.key}`} data-tip-toggle data-tip-src={ch.img} data-tip-name={ch.name}>
            {ch.key === 'wechat' ? (
              <svg class="tip-btn-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.7 5.5C5.4 6 3 8.4 3 11.3c0 1.7 1 3.3 2.6 4.4l-.6 1.9 2.1-1.1c.8.2 1.6.3 2.4.2l-.4-1.6 1.6-.8c.6 1 1.5 1.8 2.6 2.3l-.4-1.6 1.6-.8c1.9-2.1 1.4-5.6-.7-7.6-1.4-1.3-3.4-2.6-5-2.7Z"/><path d="M16.5 6.6c-3-.2-5.6 2-5.8 4.8-.2 2.8 2.1 5.2 4.9 5.5l.5 1.7 1.7-.9-.5-1.5c1-.4 1.8-1 2.4-1.8 1.5-1.8 1-4.9-1.2-6.4a5 5 0 0 0-2-1.4Z"/></svg>
            ) : (
              <svg class="tip-btn-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C8.7 3 6 5.2 6 8.5 6 11.4 7.8 13 9 14.3c.5.5 1.2 1.3 1.4 2.2h3.2c.2-.9.9-1.7 1.4-2.2C16.2 13 18 11.4 18 8.5 18 5.2 15.3 3 12 3Zm0 12.5a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8Z"/></svg>
            )}
            {ch.name}
          </button>
          <div class="tip-qr" id={`tip-qr-${ch.key}`} role="dialog" aria-label={ch.name} data-tip-qr hidden>
            <img data-tip-qr-img alt={ch.name} width="150" height="150" loading="lazy" />
            <span class="tip-qr-name" data-tip-qr-name>{ch.name}</span>
          </div>
        </div>
      ))}
    </div>
  )}

  <p class="tip-note">{t.note}</p>
</section>

<style>
  .tip-card {
    margin: 2.5rem auto;
    max-width: var(--prose-w);
    padding: 2rem 1.5rem 1.6rem;
    text-align: center;
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .tip-emoji {
    font-size: 2rem;
    line-height: 1;
    margin-bottom: 0.75rem;
  }
  .tip-desc {
    margin: 0 auto 1.25rem;
    max-width: 26rem;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.65;
  }
  .tip-note {
    margin: 1.1rem auto 0;
    max-width: 26rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .tip-actions {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .tip-btn-wrap {
    position: relative;
  }
  .tip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.2rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--paper);
    color: var(--accent);
    font: inherit;
    font-size: 0.98rem;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .tip-btn:hover,
  .tip-btn:focus-visible {
    background: var(--accent-soft);
  }
  .tip-btn-primary {
    background: var(--accent);
    color: var(--paper-strong);
  }
  .tip-btn-primary:hover {
    background: var(--accent);
  }
  .tip-btn-ico {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }
  /* ---- 二维码弹层：按钮上方弹出 ---- */
  .tip-qr {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.6rem);
    transform: translateX(-50%);
    z-index: 40;
    min-width: 10rem;
    padding: 0.7rem;
    text-align: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.16);
  }
  .tip-qr img {
    display: block;
    width: 8.25rem;
    height: 8.25rem;
    border-radius: 6px;
    background: #fff;
  }
  .tip-qr-name {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>

<script>
  // 中文：每个渠道按钮悬浮(桌面)或点按(触屏)时，在其上方弹出对应收款码；关
  // 闭：点外部 / Esc / 离开按钮(仅悬浮时)。一个页面只有一张中文打赏卡片。
  (function () {
    const card = document.querySelector<HTMLElement>('[data-tip-card]');
    if (!card) return;
    const wraps = Array.from(card.querySelectorAll<HTMLElement>('[data-tip-wrap]'));
    if (!wraps.length) return; // 英文页：无可弹层交互

    const hasHover = window.matchMedia('(hover: hover)').matches;
    const openFor = (wrap: HTMLElement) => {
      const qr = wrap.querySelector<HTMLElement>('[data-tip-qr]');
      const toggle = wrap.querySelector<HTMLElement>('[data-tip-toggle]');
      if (!qr || !toggle) return;
      const img = qr.querySelector<HTMLElement>('[data-tip-qr-img]');
      const src = toggle.dataset.tipSrc;
      const name = toggle.dataset.tipName ?? '';
      if (img && src) img.setAttribute('src', src);
      const nameEl = qr.querySelector<HTMLElement>('[data-tip-qr-name]');
      if (nameEl && name && nameEl.textContent !== name) nameEl.textContent = name;
      qr.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    };
    const closeAll = () => {
      wraps.forEach((wrap) => {
        const qr = wrap.querySelector<HTMLElement>('[data-tip-qr]');
        const toggle = wrap.querySelector<HTMLElement>('[data-tip-toggle]');
        if (qr) qr.hidden = true;
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      });
    };

    wraps.forEach((wrap) => {
      const toggle = wrap.querySelector<HTMLElement>('[data-tip-toggle]');
      if (hasHover) {
        wrap.addEventListener('mouseenter', () => openFor(wrap));
        wrap.addEventListener('mouseleave', () => {
          const qr = wrap.querySelector<HTMLElement>('[data-tip-qr]');
          if (qr) qr.hidden = true;
          const t = wrap.querySelector<HTMLElement>('[data-tip-toggle]');
          if (t) t.setAttribute('aria-expanded', 'false');
        });
      }
      toggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const qr = wrap.querySelector<HTMLElement>('[data-tip-qr]');
        const open = qr && !qr.hidden;
        closeAll();
        if (!open) openFor(wrap);
      });
    });

    document.addEventListener('click', (e) => {
      if (!card.contains(e.target as Node)) closeAll();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  })();
</script>
