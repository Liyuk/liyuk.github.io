---
// RSS 订阅入口：一句提示 + 带图标的高亮链接，指向当前语言对应的 feed
// （中文 /rss.xml，英文 /en/rss.xml）。放在文章详情页分享行之后、首页写作区，
// 把原本埋在 footer 的订阅动作提到读者读完文章、有订阅意图的位置。
import { i18n } from '../i18n/index.mjs';

const { locale = Astro.currentLocale ?? 'zh-CN' } = Astro.props as { locale?: string };
const t = i18n(locale).subscribe;
const rssHref = locale === 'en' ? '/en/rss.xml' : '/rss.xml';
---
<p class="rss-subscribe">
  <span>{t.prompt}</span>
  <a href={rssHref}>
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 11a9 9 0 0 1 9 9" />
      <path d="M4 4a16 16 0 0 1 16 16" />
      <circle cx="5" cy="19" r="1" />
    </svg>
    {t.cta}
  </a>
</p>

<style>
  .rss-subscribe {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: .88rem;
  }
  .rss-subscribe a {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: .1rem;
  }
  .rss-subscribe a:hover { color: var(--ink); border-color: var(--accent); }
</style>
