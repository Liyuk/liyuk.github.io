---
// Giscus 评论区。未启用时（comments.enabled=false）不渲染任何东西。
// 启用后：评论以 Discussion 存进 GitHub 仓库，可经 GraphQL API 导出。
import { comments } from '../data/comments.mjs';

const { lang = 'zh-CN' } = Astro.props;
const giscusLang = lang === 'en' ? 'en' : 'zh-CN';
---

{comments.enabled && (
  <section class="comments" data-pagefind-ignore>
    <div class="giscus"></div>
  </section>
)}

<script define:vars={{ enabled: comments.enabled, repo: comments.repo, repoId: comments.repoId, category: comments.category, categoryId: comments.categoryId, mapping: comments.mapping, lightTheme: comments.lightTheme, darkTheme: comments.darkTheme, giscusLang }}>
  if (enabled) {
    // 用运行时注入的方式加载 giscus，这样能动态决定主题（跟随 data-theme）。
    const dark = document.documentElement.dataset.theme === 'dark';
    const initialTheme = dark ? darkTheme : lightTheme;

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.setAttribute('data-repo', repo);
    script.setAttribute('data-repo-id', repoId);
    script.setAttribute('data-category', category);
    script.setAttribute('data-category-id', categoryId);
    script.setAttribute('data-mapping', mapping);
    script.setAttribute('data-strict', '1');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'top');
    script.setAttribute('data-theme', initialTheme);
    script.setAttribute('data-lang', giscusLang);
    script.setAttribute('data-loading', 'lazy');

    const mount = document.querySelector('.giscus');
    mount?.replaceChildren(script);

    // 主题切换时同步 giscus iframe。
    const sendTheme = () => {
      const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (!iframe?.contentWindow) return;
      const nextDark = document.documentElement.dataset.theme === 'dark';
      iframe.contentWindow.postMessage({ giscus: { setConfig: { theme: nextDark ? darkTheme : lightTheme } } }, 'https://giscus.app');
    };
    new MutationObserver(sendTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
