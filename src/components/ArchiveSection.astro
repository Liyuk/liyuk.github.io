---
// Generic archive block for research / projects year and month archives.
// Props: collection (research/projects), entries, label, action (card CTA),
// kind (year/month), year, month, eyebrow.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentEntryCard from './ContentEntryCard.astro';
import { i18n } from '../i18n/index.mjs';

interface Props {
  collection: 'projects' | 'research';
  entries: CollectionEntry<'project'>[] | CollectionEntry<'research'>[];
  label: string;
  action: string;
  kind?: 'year' | 'month';
  year: number;
  month?: number;
  eyebrow?: string;
  description?: string;
}

const {
  collection,
  entries,
  label,
  action,
  kind = 'year',
  year,
  month,
  eyebrow,
  description,
} = Astro.props as Props;

const locale = Astro.currentLocale ?? 'zh-CN';
const ui = i18n(locale);
const pageCopy = i18n(locale).page;
const archiveCopy = collection === 'projects' ? pageCopy.projectArchive : pageCopy.researchArchive;
const title = kind === 'month' ? archiveCopy.titleMonth(year, month) : archiveCopy.title(year);
const metaTitle = archiveCopy.metaTitle(year, ui.brand);
const resolvedEyebrow = eyebrow ?? archiveCopy.eyebrow;
const resolvedDescription = description ?? archiveCopy.description;
---

<BaseLayout title={metaTitle} description={resolvedDescription}>
  <section class="page-heading shell"><p class="eyebrow">{resolvedEyebrow}</p><h1>{title}</h1><p>{resolvedDescription}</p></section>
  <section class="shell entry-list archive-list">{entries.map((entry) => <ContentEntryCard entry={entry} collection={collection} label={label} action={action} locale={locale} />)}</section>
</BaseLayout>
