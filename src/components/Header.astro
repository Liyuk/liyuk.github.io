---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site } from '../data/site.mjs';
import { i18n } from '../i18n/index.mjs';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { searchUrl } from '../lib/content-paths.ts';
const { currentPath = '/', locale = Astro.currentLocale ?? 'zh-CN', showLanguageSwitch = true } = Astro.props;
const ui = i18n(locale);
const otherLocale = locale === 'en' ? 'zh-CN' : 'en';
const rootPath = currentPath.replace(/^\/en(?=\/|$)/, '');
const alternateHref = getRelativeLocaleUrl(otherLocale, rootPath);
---

<header class="site-header">
  <a class="wordmark" href={locale === 'en' ? '/en/' : '/'} aria-label={ui.accessibility.home}>{ui.brandShort}<span>.</span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={ui.navigation.menuOpen} data-menu-toggle data-menu-open={ui.navigation.menuOpen} data-menu-close={ui.navigation.menuClose}>
    <Icon name="menu" size="md" />
  </button>
  <div class="utility-controls" aria-label={ui.accessibility.siteSettings}>
    <a class="search-link" href={searchUrl(locale)} title={ui.ux.searchHint} aria-keyshortcuts="/" data-search-link><Icon name="search" size="sm" /><span class="visually-hidden">{ui.navigation.search}</span></a>
    <a class="tags-link" href={getRelativeLocaleUrl(locale, '/tags/')} aria-current={currentPath.startsWith(getRelativeLocaleUrl(locale, '/tags/')) ? 'page' : undefined}>{ui.navigation.tags}</a>
    {showLanguageSwitch && <a class="language-switch" href={alternateHref} lang="en"><b>{ui.language.current}</b><i>/</i><em>{ui.language.alternate}</em></a>}
    <ThemeToggle labels={ui.theme} />
  </div>
  <nav id="site-nav" aria-label={ui.navigation.main}>
    <ul>
      {site.navigation.map((item) => (
        <li><a href={getRelativeLocaleUrl(locale, item.href)} aria-current={currentPath.startsWith(getRelativeLocaleUrl(locale, item.href)) ? 'page' : undefined}>{ui.navigation[item.key as keyof typeof ui.navigation]}</a></li>
      ))}
      <li class="nav-tags"><a href={getRelativeLocaleUrl(locale, '/tags/')} aria-current={currentPath.startsWith(getRelativeLocaleUrl(locale, '/tags/')) ? 'page' : undefined}>{ui.navigation.tags}</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const header = document.querySelector<HTMLElement>('.site-header');

  // 移动端菜单：全宽浮层；Esc 关闭，点击导航链接关闭；打开时焦点进第一个链接，关闭时回到按钮。
  const setMenu = (open: boolean, restoreFocus = false) => {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? (toggle.dataset.menuClose ?? '') : (toggle.dataset.menuOpen ?? ''));
    header?.classList.toggle('menu-open', open);
    nav.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('menu-lock', open);
    if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (restoreFocus) toggle.focus();
  };
  if (toggle && nav) {
    toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        setMenu(false, true);
      }
    });
    matchMedia('(min-width: 961px)').addEventListener('change', (event) => {
      if (event.matches) setMenu(false);
    });
  }

  // 上划展现、下滑隐藏 sticky header；方向变化需累计超过 8px 才触发，避免抖动。
  const THRESHOLD = 8;
  let lastY = window.scrollY;
  let anchorY = lastY;
  let direction = 0;
  const onScroll = () => {
    const y = window.scrollY;
    if (y < 80 || header?.classList.contains('menu-open')) {
      header?.classList.remove('is-hidden');
      lastY = anchorY = y;
      direction = 0;
      return;
    }
    const dir = y > lastY ? 1 : y < lastY ? -1 : direction;
    if (dir !== direction) {
      direction = dir;
      anchorY = lastY;
    }
    if (Math.abs(y - anchorY) >= THRESHOLD) header?.classList.toggle('is-hidden', direction > 0);
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
