---
import { contentUrl, galleryUrl } from '../lib/content-paths.ts';
import { i18n } from '../i18n/index.mjs';

// 「继续阅读」相关推荐区块，用于写作/研究/项目/图集四类详情页底部。
// 接收 getRelatedEntries 的结果，跨类型渲染成紧凑卡片网格（类型徽标 + 标题
// + 描述 + CTA）。URL 按 collection 分派：gallery 用 data.slug，其余用 id。
type RelatedItem = {
  entry: {
    id: string;
    collection: string;
    data: { slug?: string; title: string; description?: string };
  };
  reasons: string[];
};

interface Props {
  items: RelatedItem[];
  locale?: string;
}

type Card = {
  href: string;
  label: string;
  action: string;
  title: string;
  description?: string;
  reasons: string[];
};

const { items, locale: localeProp } = Astro.props;
const locale = localeProp ?? Astro.currentLocale ?? 'zh-CN';
const pageCopy = i18n(locale).page;
const eyebrow = pageCopy.writingDetail.relatedEyebrow;
const title = pageCopy.writingDetail.relatedTitle;
const cardCopy = pageCopy.tagCards;

function href(collection: string, entry: RelatedItem['entry']): string {
  return collection === 'gallery'
    ? galleryUrl(entry.data.slug ?? entry.id, locale)
    : contentUrl(collection, entry.id, locale);
}

const cards: Card[] = items.map(({ entry, reasons }) => {
  const collection = entry.collection as keyof typeof cardCopy;
  const copy = cardCopy[collection];
  return {
    href: href(entry.collection, entry),
    label: copy?.label ?? entry.collection,
    action: copy?.action ?? '阅读全文',
    title: entry.data.title,
    description: entry.data.description,
    reasons,
  };
});
---

<section class="related-entries" aria-labelledby="related-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id="related-heading">{title}</h2>
  <ul class="related-grid">
    {cards.map((card: Card) => (
      <li class="related-card">
        <a class="related-card-link" href={card.href}>
          <span class="related-type">{card.label}</span>
          <span class="related-card-title">{card.title}</span>
          {card.description && <span class="related-desc">{card.description}</span>}
          <span class="related-cta">{card.action} <span aria-hidden="true">→</span></span>
        </a>
        {card.reasons.length > 0 && (
          <p class="related-reason">{card.reasons.join(' · ')}</p>
        )}
      </li>
    ))}
  </ul>
</section>
