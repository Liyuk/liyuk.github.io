---
import { iconPaths, type IconName } from '../lib/icons.ts';

interface Props {
  name: IconName;
  size?: 'sm' | 'md' | 'lg';
  label?: string;
  class?: string;
}

const { name, size = 'md', label, class: className } = Astro.props as Props;
---
<svg
  class:list={['icon', `icon-${size}`, className]}
  data-icon={name}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={iconPaths[name]}
/>

<style>
  .icon {
    display: inline-block;
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    flex: 0 0 auto;
    vertical-align: -.18em;
  }

  .icon-sm {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .icon-lg {
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
  }
</style>
