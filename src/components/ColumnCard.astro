---
// Column card: shows the full chapter list of the current article's column,
// bolding the current entry; collapsible (expanded by default).
import type { CollectionEntry } from 'astro:content';
import { getColumn, getColumnEntries } from '../lib/taxonomy.ts';
import { columnEntryUrl } from '../lib/content-paths.ts';
import { i18n } from '../i18n/index.mjs';
import { readingMinutes } from '../lib/reading-time.ts';

type ColumnMember = CollectionEntry<'writing'> | CollectionEntry<'consulting'> | CollectionEntry<'research'> | CollectionEntry<'gallery'>;

interface Props {
  entry: ColumnMember;
  columnSlug: string;
  locale?: string;
  allEntries?: ColumnMember[];
}

const {
  entry,
  columnSlug,
  locale = Astro.currentLocale ?? 'zh-CN',
  allEntries = [],
} = Astro.props as Props;

const ui = i18n(locale);
const column = getColumn(columnSlug, locale);

const columnEntries = getColumnEntries(allEntries, columnSlug);
const currentId = entry.id;
---

{column && (
<div class="column-card" data-open="true">
  <button class="column-card-toggle" type="button" aria-expanded="true">
    <span class="column-card-title">
      <span class="eyebrow">{ui.column.eyebrow}</span>
      <strong>{column.label}</strong>
      <em class="column-card-count">{ui.column.count(columnEntries.length)}</em>
    </span>
    <span class="column-card-chevron" aria-hidden="true">⌄</span>
  </button>
  <ol class="column-card-list">
    {columnEntries.map((colEntry) => {
      const isCurrent = colEntry.id === currentId;
      const typeKey = colEntry.collection === 'writing' ? colEntry.data.type : colEntry.collection;
      const type = ui.entry.types[typeKey as keyof typeof ui.entry.types] ?? typeKey;
      const meta = `${type} · ${ui.entry.readingMinutes(readingMinutes(colEntry.body, locale))}`;
      return (
        <li class:list={{ current: isCurrent }}>
          {isCurrent ? (
            <span class="column-card-item-current">
              <span class="column-card-order">{colEntry.data.column!.order}</span>
              <span><strong>{colEntry.data.title}</strong><em class="column-card-meta">{meta}</em></span>
              <em class="column-card-you">{ui.column.current}</em>
            </span>
          ) : (
            <a href={columnEntryUrl(colEntry, locale)}>
              <span class="column-card-order">{colEntry.data.column!.order}</span>
              <span><span>{colEntry.data.title}</span><em class="column-card-meta">{meta}</em></span>
            </a>
          )}
        </li>
      );
    })}
  </ol>
</div>
)}

<style>
  .column-card {
    margin: 1.25rem auto 2.5rem;
    max-width: var(--prose-w);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--paper-strong);
  }
  .column-card-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--ink);
    text-align: left;
    font-family: inherit;
  }
  .column-card-toggle:hover {
    background: var(--accent-soft);
  }
  .column-card-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .column-card-title .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .column-card-title strong {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .column-card-count {
    color: var(--muted);
    font-size: 0.78rem;
    font-style: normal;
  }
  .column-card-chevron {
    color: var(--muted);
    font-size: 0.9rem;
    transition: transform 0.2s ease;
    transform: rotate(0deg);
  }
  .column-card[data-open="false"] .column-card-chevron {
    transform: rotate(-90deg);
  }
  .column-card-list {
    margin: 0;
    padding: 0 1.1rem 0.7rem;
    list-style: none;
    display: grid;
    gap: 0.1rem;
  }
  .column-card[data-open="false"] .column-card-list {
    display: none;
  }
  .column-card-list a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.35rem 0.3rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.92rem;
    border-radius: 5px;
  }
  .column-card-list a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .column-card-order {
    flex-shrink: 0;
    width: 1.2rem;
    color: var(--muted);
    font-size: 0.72rem;
    text-align: right;
  }
  .column-card-item-current {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.35rem 0.3rem;
    font-size: 0.92rem;
    border-radius: 5px;
    background: var(--accent-soft);
  }
  .column-card-item-current strong {
    font-weight: 700;
  }
  .column-card-you {
    margin-left: auto;
    color: var(--accent);
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .column-card-meta {
    display: block;
    margin-top: .1rem;
    color: var(--muted);
    font-size: .68rem;
    font-style: normal;
    font-weight: 400;
    letter-spacing: .01em;
  }
</style>

<script>
  // A detail page has at most one column card; a single data-open state controls folding.
  const card = document.querySelector('.column-card');
  if (card instanceof HTMLElement) {
    const toggle = card.querySelector('.column-card-toggle');
    toggle?.addEventListener('click', () => {
      const isOpen = card.dataset.open !== 'false';
      card.dataset.open = String(!isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
