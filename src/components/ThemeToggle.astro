---
const { labels } = Astro.props;
---
<button class="theme-toggle" type="button" data-theme-toggle data-light-label={labels.toDark} data-dark-label={labels.toLight} aria-label={labels.toDark} title={labels.toDark}>
  <span aria-hidden="true">◐</span>
</button>

<script>
  const button = document.querySelector<HTMLElement>('[data-theme-toggle]');
  const storageKey = 'liyuk-theme';

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
    const label = theme === 'dark' ? button?.dataset.darkLabel : button?.dataset.lightLabel;
    if (label) {
      button?.setAttribute('aria-label', label);
      button?.setAttribute('title', label);
    }
  }

  const savedTheme = localStorage.getItem(storageKey);
  const initialTheme: string = savedTheme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  applyTheme(initialTheme);

  button?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem(storageKey, nextTheme);
    applyTheme(nextTheme);
  });
</script>
