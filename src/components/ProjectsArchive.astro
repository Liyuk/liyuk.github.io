---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { i18n } from '../i18n/index.mjs';
import { contentUrl } from '../lib/content-paths.ts';
import { isoDate } from '../lib/format-dates.ts';
import { publishedIn } from '../lib/content-model.ts';
import { sortByCreatedAt } from '../lib/timeline.ts';
import { publishedDate } from '../lib/timeline.ts';
import { PAGE_SIZE, paginateList } from '../lib/pagination.ts';
import PaginationNav from './PaginationNav.astro';

const { page = 1 } = Astro.props;
const locale = Astro.currentLocale ?? 'zh-CN';
const copy = i18n(locale).page.projects;
const projectStatus = i18n(locale).page.home.projects.status;
const projects = sortByCreatedAt(await getCollection('project', publishedIn(locale)));
const prefix = locale === 'en' ? '/en/projects/' : '/projects/';
const { items, currentPage, totalPages, prevUrl, nextUrl } = paginateList(projects, page, PAGE_SIZE, prefix);
const titleSuffix = currentPage > 1 ? i18n(locale).pagination.pageTitleSuffix(currentPage) : '';
---

<BaseLayout title={copy.metaTitle + titleSuffix} description={copy.metaDescription} pageKind="collection" section="projects" seoPage="projects">
  <section class="page-heading shell"><h1>{copy.title[0]}<br />{copy.title[1]}</h1><p>{copy.description}</p></section>
  <section class="shell entry-list archive-list">
    {items.map((project) =>
      project.data.workUrl && project.data.work ? (
        <article class="entry-card row-entry work-card">
          <time class="row-date mono" datetime={isoDate(publishedDate(project))}>{publishedDate(project).getFullYear()}</time>
          <div class="row-body">
            <h2><a class="row-link" href={project.data.workUrl} target="_blank" rel="noopener noreferrer">{project.data.title}<span aria-hidden="true"> ↗</span><span class="visually-hidden">{copy.readOn(project.data.work.platform)}</span></a></h2>
            <p class="entry-type">{[project.data.work.penName, project.data.work.platform].filter(Boolean).join(' · ')}</p>
            <p>{project.data.description}</p>
          </div>
          <span class="row-aside mono"><span class:list={['status-line', { 'is-archived': project.data.status === 'archived' }]} aria-hidden="true"></span>{projectStatus[project.data.status]}</span>
        </article>
      ) : (
        <article class="entry-card row-entry">
          <time class="row-date mono" datetime={isoDate(publishedDate(project))}>{publishedDate(project).getFullYear()}</time>
          <div class="row-body">
            <h2><a class="row-link" href={contentUrl('projects', project.id, locale)}>{project.data.title}</a></h2>
            <p>{project.data.description}</p>
          </div>
          <span class="row-aside mono"><span class:list={['status-line', { 'is-archived': project.data.status === 'archived' }]} aria-hidden="true"></span>{projectStatus[project.data.status]}</span>
        </article>
      )
    )}
    <PaginationNav prevUrl={prevUrl} nextUrl={nextUrl} currentPage={currentPage} totalPages={totalPages} locale={locale} />
  </section>
</BaseLayout>
